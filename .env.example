# Set these in Replit Secrets; .env is not loaded automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
CONFESSIONS_CHANNEL_ID=-1000000000000
PORT=8080

# Optional: the existing non-AI features can be switched off individually.
FEATURE_CONVERSATION=true
FEATURE_CONFESSIONS=true
FEATURE_MOOD=true
FEATURE_REMINDERS=true
BOT_TIMEZONE=Europe/Kyiv
BOOKS_PATH=./data/books

# Daily AI-chat limit (turns per day in BOT_TIMEZONE; quick merged messages count once).
CHAT_DAILY_FREE_MESSAGES=30
# «Друг+»: no daily limit, only this technical ceiling per account per day.
PLUS_DAILY_MAX_MESSAGES=300
# «Друг+» price in Telegram Stars for 30 days, one-off, no auto-renewal.
PLUS_PRICE_STARS=70
# Optional links; an empty value hides the button/line. Full https:// links only.
DONATE_URL=
TIKTOK_URL=https://www.tiktok.com/@trivozhna.na
# Shown by /paysupport, e.g. @username or an e-mail.
SUPPORT_CONTACT=

# Optional operational limits; defaults are suitable for a small bot.
AI_MAX_CONCURRENCY=2
AI_TIMEOUT_SECONDS=45
AI_JOB_BUDGET_SECONDS=100
CHAT_QUIET_MS=900
CHAT_MAX_GATHER_MS=3000
# CHAT_CONTENT_PATH=/absolute/path/to/Chat
# Prompt, examples and generation settings live in src/Bot/Resources/Chat.
# Account quotas are enforced by Google; retries respect its 429 responses.

# Set these in Replit Secrets. The app does not automatically load .env files.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
TELEGRAM_BOT_TOKEN=YOUR_TEST_BOT_TOKEN
GROQ_API_KEY=YOUR_GROQ_API_KEY
CONFESSIONS_CHANNEL_ID=-1000000000000
PORT=8080
BOT_TIMEZONE=Europe/Kyiv
# SillyTavern UA defaults. Existing Replit Secrets override these values.
# Chat uses ordinary text; the old planning Secrets are no longer read.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
# Writer reasoning stays invisible. none/low/medium/high.
GROQ_CHAT_REASONING_EFFORT=low
AI_MAX_CONCURRENCY=2
AI_TIMEOUT_SECONDS=45
AI_JOB_BUDGET_SECONDS=100
AI_MAX_QUEUE_WAIT_SECONDS=300
AI_INPUT_TOKEN_BUDGET=4800
AI_MEMORY_CONTEXT_TOKENS=700
AI_BOOK_CONTEXT_TOKENS=850
# Initial output ceiling includes hidden reasoning and the visible text.
# Incomplete output can retry once with a larger ceiling within quota.
AI_TURN_OUTPUT_TOKEN_BUDGET=2048
# Adjust these to the actual limits shown in your Groq organization.
GROQ_RPM=25
GROQ_TPM=8000
GROQ_RPD=900
GROQ_TPD=190000
MAX_INBOX_QUEUE=10000
MAX_USER_AI_QUEUE=20
# Wait for a short burst; cap how long continuous typing can postpone the reply.
CHAT_QUIET_MS=1200
CHAT_MAX_GATHER_MS=3000
BOOK_CHUNK_CHARS=1800
BOOK_CHUNK_OVERLAP=180
BOOKS_PATH=./data/books
FEATURE_CONVERSATION=true
FEATURE_CONFESSIONS=true
FEATURE_MOOD=true
FEATURE_REMINDERS=true
# Disposable test DB only. Tests create and drop isolated test schemas.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE?sslmode=require
